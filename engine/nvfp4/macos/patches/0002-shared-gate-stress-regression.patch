From c59b0954129c6ee4e9c9eaa9ebc2fdea3c542f37 Mon Sep 17 00:00:00 2001
From: jerryfane <38183696+jerryfane@users.noreply.github.com>
Date: Sun, 25 Oct 2026 05:16:43 +0400
Subject: [PATCH] tests: discriminate shared-gate sums after sigmoid

Center the exact FP32 dot at one so sigmoid saturation cannot hide a
lower-precision accumulator's overflow. Production kernels and tolerance
widths are unchanged.

The independent CPU regression passed for FP16 and BF16 in all three sum
orders. Only the corrected failed GPU variant was rerun on Apple M5 Ultra:
1/1 passed, retaining the other 13 variants and runtime-limit receipts.

---
 zig/build/kernel_contract.zig              |  7 ++++--
 zig/tests/contract/drama3_nvfp4_ref.zig    | 25 ++++++++++++++++++++++
 zig/tests/contract/metal_drama_combine.zig | 13 +++++------
 3 files changed, 37 insertions(+), 8 deletions(-)

diff --git a/zig/build/kernel_contract.zig b/zig/build/kernel_contract.zig
index fcac3fff..d8a7ca1c 100644
--- a/zig/build/kernel_contract.zig
+++ b/zig/build/kernel_contract.zig
@@ -36,14 +36,17 @@ pub fn hostTests(b: *std.Build, family: *std.Build.Step) void {
     }) }));
     b.step("test-delta-slots-contract-host", "FP64 DeltaNet and slot corruption controls without shaders").dependOn(&delta.step);
     step.dependOn(&delta.step);
-    const nvfp4 = b.addRunArtifact(b.addTest(.{ .root_module = b.createModule(.{
+    const nvfp4_module = b.createModule(.{
         .root_source_file = b.path("zig/tests/contract/drama3_nvfp4_ref.zig"),
         .target = b.graph.host,
         .optimize = .debug,
         .imports = &.{.{ .name = "contract", .module = module(b, b.graph.host, .debug) }},
-    }) }));
+    });
+    const nvfp4 = b.addRunArtifact(b.addTest(.{ .root_module = nvfp4_module }));
     b.step("test-drama-nvfp4-reference-host", "NVFP4 scalar reference and reduced-accumulator discrimination").dependOn(&nvfp4.step);
     step.dependOn(&nvfp4.step);
+    const shared_gate = b.addRunArtifact(b.addTest(.{ .root_module = nvfp4_module, .filters = &.{"shared gate stress"} }));
+    b.step("test-drama-combine-stress-host", "Shared-gate stress remains discriminating after nonlinear output").dependOn(&shared_gate.step);
 }
 
 /// macOS: tf-kernel-contract over the engine's Metal kernels; `kernel-contract` runs it on this Mac's GPU.
diff --git a/zig/tests/contract/drama3_nvfp4_ref.zig b/zig/tests/contract/drama3_nvfp4_ref.zig
index 6ee80a54..ac766bc6 100644
--- a/zig/tests/contract/drama3_nvfp4_ref.zig
+++ b/zig/tests/contract/drama3_nvfp4_ref.zig
@@ -182,6 +182,31 @@ pub fn upRange(gate: Interval, up: Interval) Interval {
     return fp32(g.mul(inverse)).mul(u).rounded();
 }
 
+pub const shared_gate_terms = 65;
+
+pub fn sharedGateStressTerm(i: usize) f32 {
+    return if (i < 16) 32768 else if (i < 48) 1 else if (i < 64) -32768 else if (i == 64) -31 else 0;
+}
+
+pub fn sharedGateOutput(dot: f64) f64 {
+    return bf(2 / (1 + @exp(-dot)));
+}
+
+test "shared gate stress remains discriminating after sigmoid and BF16 output" {
+    var terms: [2048]f64 = @splat(0);
+    for (terms[0..shared_gate_terms], 0..) |*v, i| v.* = sharedGateStressTerm(i);
+    const want = sharedGateOutput(1);
+    try std.testing.expectEqual(@as(f64, 1.4609375), want);
+    for ([_]rows.Order{ .sequential, .pairwise, .strided }) |order| {
+        try std.testing.expectEqual(@as(f64, 1), rows.sumIn(.f32, order, &terms));
+        for ([_]c.Accum{ .f16, .bf16 }) |acc| {
+            const got = sharedGateOutput(rows.sumIn(acc, order, &terms));
+            // Exact FP32 sums yield one stable BF16 value, so the stress interval has zero width.
+            try std.testing.expect(!std.math.isFinite(got) or got != want);
+        }
+    }
+}
+
 test "NVFP4 independent decoding includes signs, subnormal scales, signed zero and maximum finite scale" {
     try std.testing.expectEqual(@as(f64, 0.5), fp4(1));
     try std.testing.expectEqual(@as(f64, -6), fp4(15));
diff --git a/zig/tests/contract/metal_drama_combine.zig b/zig/tests/contract/metal_drama_combine.zig
index 2e6893c0..21291a6b 100644
--- a/zig/tests/contract/metal_drama_combine.zig
+++ b/zig/tests/contract/metal_drama_combine.zig
@@ -5,6 +5,7 @@ const contract = @import("contract");
 const bfr = contract.bf16_round;
 const rig_ = @import("rig.zig");
 const source = @import("metal_drama3.zig").source;
+const ref = @import("drama3_nvfp4_ref.zig");
 const c = contract.spec;
 const g = contract.gates;
 pub const Variant = enum { pairs, shared_gate };
@@ -132,9 +133,9 @@ pub const Combine = struct {
                 for (0..shape.rows) |row| for (terms, 0..) |v, slot|
                     @memset(t.down[(row * 8 + slot) * shape.k ..][0..shape.k], v * 8);
             } else {
-                // Exact sum 32, magnitude 2^20+32: FP16 overflows, BF16 loses the central ones in all orders.
-                for (0..shape.rows) |row| for (0..64) |i| {
-                    t.x[row * shape.k + i] = c.toBf16(if (i < 16) 32768 else if (i < 48) 1 else -32768);
+                // Exact dot 1 avoids sigmoid saturation hiding a reduced-precision sum's overflow.
+                for (0..shape.rows) |row| for (0..ref.shared_gate_terms) |i| {
+                    t.x[row * shape.k + i] = c.toBf16(ref.sharedGateStressTerm(i));
                 };
             }
         }
@@ -167,7 +168,7 @@ pub const Combine = struct {
         const p = t.rig.begin();
         p.e.setPipeline(t.pipe);
         p.e.setBuffer(t.out.buf, t.out.off, 0);
-        for (t.refs, 1..) |ref, slot| p.e.setBuffer(ref.buf, ref.off, slot);
+        for (t.refs, 1..) |buffer, slot| p.e.setBuffer(buffer.buf, buffer.off, slot);
         p.e.setValue(@as(u32, @intCast(t.shape.k)), 6);
         p.e.dispatchGroups(mtl.Size.of(t.shape.rows, 1, 1), mtl.Size.of(256, 1, 1));
         try t.rig.finish(p);
@@ -237,8 +238,8 @@ pub const Combine = struct {
 
     pub fn intervals(t: *Combine, low: []f64, high: []f64) !void {
         if (t.fill == .stress) {
-            // Integer sums/products are exact in FP32. sigmoid(32)*2 rounds to BF16 2, far from a boundary.
-            const exact: f64 = if (t.variant == .pairs) 6 else 2;
+            // Exact FP32 integer sums stay away from BF16 rounding boundaries after the sigmoid.
+            const exact: f64 = if (t.variant == .pairs) 6 else ref.sharedGateOutput(1);
             @memset(low, exact);
             @memset(high, exact);
             return;
