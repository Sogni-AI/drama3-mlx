+    try expectSentWith(a, &.{ high, unmeasured }, &.{ .stop, .silence }, on, "", 0, 2, true, used);
+    try expectSentWith(a, &.{ high, unmeasured }, &.{ .stop, .stop }, on, "", 0, 2, false, used);
+}
+
+test "register headers are absent on streams and errors, and register-only streams validate deadlines" {
+    const Case = struct { body: []const u8, headers: []const u8 = "", status: []const u8 };
+    for ([_]Case{
+        .{ .body = harness.stream_body, .status = "HTTP/1.1 200" },
+        .{ .body = harness.stream_body, .headers = "X-Deadline-S: soon\r\n", .status = "HTTP/1.1 400" },
+        .{ .body = "{\"model\":\"m\"}", .status = "HTTP/1.1 400" },
+    }) |case| {
+        var script: harness.Script = .{ .steps = &.{harness.frame}, .inline_ = true };
+        var s: harness.Served = undefined;
+        try s.open(&script, .{ .served_name = "m", .model_ids = &.{"m"}, .redraw = .{ .register = rule } }, case.headers, "HTTP/1.1", case.body, 2000);
+        defer s.deinit();
+        const head = head: {
+            defer s.join(&script);
+            _ = try s.readHead();
+            _ = try s.readRest();
+            break :head s.got.items[0..s.read_at];
+        };
+        try harness.expectHeader(head, case.status);
+        try std.testing.expect(std.mem.indexOf(u8, head, "X-Register-") == null);
+        try std.testing.expect(std.mem.indexOf(u8, head, "X-Silence-Redraws") == null);
+    }
+}
+
+test "short register redraws cannot win and discarded mid trips still count" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const high = try tones(a, 44100, &reply(130, 330));
+    const flat = try tones(a, 44100, &reply(130, 127));
+    const unmeasured = try a.alloc(f32, high.len);
+    @memset(unmeasured, 0);
+    const body = "{\"model\":\"m\",\"input\":\"" ++ @as([200]u8, @splat('a')) ++ "\",\"response_format\":\"pcm\"}";
+    for ([_]bool{ false, true }) |mid| {
+        for ([_][]const f32{ flat, unmeasured }) |later| {
+            for ([_]bool{ false, true }) |clean| {
+                var script: harness.Script = .{
+                    .steps = &.{high.len},
+                    .audio = &.{ high, later, later },
+                    .reasons = &.{ .length, if (mid) .silence else .stop, if (clean) .length else .stop },
+                    .mid_takes = &.{ false, mid },
+                    .max_frames = @intCast(high.len / harness.frame + 1),
+                    .inline_ = true,
+                };
+                var s: harness.Served = undefined;
+                const policy: Policy = .{ .max = 1, .register = rule, .short_ratio = 0.6, .short_chars_per_s = 10 };
+                try s.open(&script, .{ .served_name = "m", .model_ids = &.{"m"}, .redraw = policy, .silence_guard = true, .silence_mid = true }, "", "HTTP/1.1", body, 2000);
+                defer s.deinit();
+                const audio = audio: {
+                    defer s.join(&script);
+                    _ = try s.readHead();
+                    break :audio try s.readRest();
+                };
+                const head = s.got.items[0..s.read_at];
+                try harness.expectHeader(head, "X-Finish-Reason: length\r\nX-Silence-Redraws: 1\r\n");
+                try harness.expectHeader(head, if (mid) "X-Silence-Mid-Trips: 1\r\n" else "X-Silence-Mid-Trips: 0\r\n");
+                try harness.expectHeader(head, "X-Register-Trip: 1\r\nX-Register-Redraws: 1\r\n");
+                try std.testing.expectEqualSlices(u8, try quantizeInPlace(try a.dupe(f32, if (clean) later else high)), audio);
+                try std.testing.expectEqual(@as(usize, 3), script.takes);
+            }
+        }
+    }
+}
