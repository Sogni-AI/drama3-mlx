Subject: [PATCH 02/11] fix(drama3): complete replay poison before resetting
 streams

---
 docs/drama3-prefill.md                      |  2 ++
 zig/src/families/drama3/cuda/codec.zig      |  2 ++
 zig/src/families/drama3/cuda/engine.zig     |  2 ++
 zig/src/families/drama3/cuda/owner_test.zig | 31 +++++++++++++++++++++
 4 files changed, 37 insertions(+)

diff --git a/docs/drama3-prefill.md b/docs/drama3-prefill.md
index 8a6c7803..60aca66e 100644
--- a/docs/drama3-prefill.md
+++ b/docs/drama3-prefill.md
@@ -39,6 +39,8 @@ The comparator requires complete, contiguous coverage of every backbone and towe
 
 Run `--replay 1` at each selected capacity to retain the existing exact eager/graph, poison/reset, codec chunking and interleaved-lane checks. Repeat a fixed-seed request with the same capacity and require identical frame and PCM bytes. Compare capacities 64, 128 and the default explicitly; record whether their outputs differ. The default and explicit 128 must have the same partition.
 
+CUDA replay poisoning waits for its default-stream fills before prompt reset or codec reset can reuse the buffers. A host-returning device memset does not order work on the engines' non-blocking streams; without this wait, poisoning can overwrite the restored attention position and cause an out-of-bounds KV write. This ordering requirement also applies to single-row prefill.
+
 For free-running audio, compare stop reason and length, then word error rate and speaker similarity on the same text and reference. Keep checkpoint and evaluation-model revisions, text normalization and thresholds fixed before the run. Report cross-capacity frame/PCM equality as information, not a rejection criterion. Performance qualification includes first-audio latency, decode rate, peak physical memory and device allocation high-water marks. A host-only test pass does not establish these GPU outcomes.
 
 Host coverage:
diff --git a/zig/src/families/drama3/cuda/codec.zig b/zig/src/families/drama3/cuda/codec.zig
index f5468948..9f874329 100644
--- a/zig/src/families/drama3/cuda/codec.zig
+++ b/zig/src/families/drama3/cuda/codec.zig
@@ -202,6 +202,8 @@ pub const Codec = struct {
 
     pub fn poison(c: *Codec) !void {
         for (c.bufs.items[c.state_start..c.state_end]) |*buffer| try buffer.fill8(0xa5, null);
+        // Reset and decode use non-blocking streams, so the default-stream fills must finish first.
+        try c.d.synchronize();
     }
 
     pub fn destroy(c: *Codec) void {
diff --git a/zig/src/families/drama3/cuda/engine.zig b/zig/src/families/drama3/cuda/engine.zig
index 1c16ce14..c0daff72 100644
--- a/zig/src/families/drama3/cuda/engine.zig
+++ b/zig/src/families/drama3/cuda/engine.zig
@@ -215,6 +215,8 @@ pub const Engine = struct {
         try e.stream.synchronize();
         try e.stream2.synchronize();
         for (e.bufs.items) |*buffer| try buffer.fill8(0xa5, null);
+        // cuMemsetD8 may return before completion; non-blocking streams do not wait for it.
+        try e.driver.synchronize();
     }
 
     fn alloc(e: *Engine, bytes: usize) !u64 {
diff --git a/zig/src/families/drama3/cuda/owner_test.zig b/zig/src/families/drama3/cuda/owner_test.zig
index 7918b0b9..d955d06a 100644
--- a/zig/src/families/drama3/cuda/owner_test.zig
+++ b/zig/src/families/drama3/cuda/owner_test.zig
@@ -126,6 +126,37 @@ const Mock = struct {
         return error.InjectedWarmFailure;
     }
 };
+test "drama poison completes default-stream fills before reset can reuse buffers" {
+    const Fill = struct {
+        var pending: bool = false;
+        fn fill(_: u64, value: u8, _: usize) callconv(.c) c_int {
+            std.debug.assert(value == 0xa5);
+            pending = true;
+            return 0;
+        }
+        fn finish() callconv(.c) c_int {
+            pending = false;
+            return 0;
+        }
+    };
+    var e: Engine = undefined;
+    Mock.init(&e);
+    e.driver.api.cuMemsetD8_v2 = Fill.fill;
+    e.driver.api.cuCtxSynchronize = Fill.finish;
+    e.bufs = .empty;
+    defer e.bufs.deinit(a);
+    try e.bufs.append(a, .{ .d = &e.driver, .ptr = 1, .len = 256, .borrowed = true });
+    try e.poison();
+    try std.testing.expect(!Fill.pending);
+    var c: Codec = undefined;
+    c.d = &e.driver;
+    c.bufs = e.bufs;
+    c.state_start = 0;
+    c.state_end = c.bufs.items.len;
+    try c.poison();
+    try std.testing.expect(!Fill.pending);
+}
+
 test "drama owner: failed fork teardown pins shared codec buffers descriptors and module through base teardown" {
     var e: Engine = undefined;
     Mock.init(&e);
