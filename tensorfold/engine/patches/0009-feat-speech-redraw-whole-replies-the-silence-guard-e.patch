+        .{ "  ordinary\ttext  ", "  ordinary\ttext  " },
+        .{ "[sighs] hello [unknown]", "hello" },
+        .{ "a[[sighs]]b", "a ]b" },
+        .{ "a[unclosed", "a[unclosed" },
+        .{ "<WHISPER>text</WHISPER> [sighs]", "<WHISPER>text</WHISPER>" },
+        .{ "<soft>text</soft>.", "text ." },
+        .{ "\t[sighs]a\n\n b\u{3000}c ", "a b c" },
