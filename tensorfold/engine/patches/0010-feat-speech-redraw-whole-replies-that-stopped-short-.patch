+    try std.testing.expect(p.trips(.stop, 1, 1000, std.mem.sliceAsBytes(&accents)));
+    const off: Policy = .{ .max = 1 };
+    try std.testing.expect(!off.trips(.stop, 1, 1000, input));
+    try std.testing.expect(off.trips(.silence, 1, 1000, input));
 }
 
