--- /dev/null
+++ b/tools/zig/drama_prefill_compare.py
@@ -0,0 +1,68 @@
+"""Compare chunked Drama prompt probes against the same oracle, without requiring cross-chunk token equality."""
+import argparse
+import json
+import math
+from pathlib import Path
+import re
+
+
+METRIC = re.compile(r"^PREFILL (\S+) start=(\d+) rows=(\d+) worst_cos=(\S+) max_abs=(\S+)$")
+EXPECTED = ({"backbone_input_embeds", "backbone_final_norm"}
+            | {f"backbone_hidden.layer{i:02}" for i in range(40)}
+            | {f"tower_prefill.layer{i:02}" for i in range(13)})
+
+
+def collect(text):
+    metrics = {}
+    for line in text.splitlines():
+        if not line.startswith("PREFILL "):
+            continue
+        match = METRIC.fullmatch(line)
+        if not match:
+            raise ValueError("malformed prefill metric")
+        name, start, rows, cosine, error = match.groups()
+        start, rows = int(start), int(rows)
+        cosine, error = float(cosine), float(error)
+        if not math.isfinite(cosine) or not math.isfinite(error) or error < 0 or rows == 0:
+            raise ValueError("invalid prefill metric")
+        item = metrics.setdefault(name, {"rows": 0, "worst_cos": 1.0, "max_abs": 0.0})
+        if start != item["rows"]:
+            raise ValueError("prompt probe gap or overlap")
+        item["rows"] += rows
+        item["worst_cos"] = min(item["worst_cos"], cosine)
+        item["max_abs"] = max(item["max_abs"], error)
+    if metrics.keys() != EXPECTED:
+        raise ValueError("incomplete prompt probes")
+    n = metrics["backbone_input_embeds"]["rows"]
+    for name, item in metrics.items():
+        if item["rows"] != n - int(name.startswith("tower_prefill.")):
+            raise ValueError("incomplete prompt rows")
+    if "RESULT drama3 check PASS:" not in text:
+        raise ValueError("upstream reference check did not pass")
+    return metrics
+
+
+def compare(baseline, candidate):
+    before, after = collect(baseline), collect(candidate)
+    results = {}
+    for name in sorted(EXPECTED):
+        a, b = before[name], after[name]
+        if a["rows"] != b["rows"]:
+            raise ValueError("different prompt vectors")
+        results[name] = {"one_row": a, "chunked": b,
+                         "pass": b["worst_cos"] >= a["worst_cos"] and b["max_abs"] <= a["max_abs"]}
+    return {"pass": all(item["pass"] for item in results.values()), "tensors": results}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("one_row", type=Path)
+    parser.add_argument("chunked", type=Path)
+    args = parser.parse_args()
+    result = compare(args.one_row.read_text(), args.chunked.read_text())
+    print(json.dumps(result, indent=2))
+    return 0 if result["pass"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/zig/test_drama_prefill_compare.py b/tools/zig/test_drama_prefill_compare.py
new file mode 100644
index 00000000..df04c98b
--- /dev/null
+++ b/tools/zig/test_drama_prefill_compare.py
@@ -0,0 +1,42 @@
+"""Exercise the oracle comparison gate with complete, misaligned and regressed prompt metrics."""
+import unittest
+from drama_prefill_compare import EXPECTED, collect, compare
+
+
+def receipt(chunk, cosine=0.999, error=1.0):
+    lines = []
+    for name in sorted(EXPECTED):
+        count = 129 - int(name.startswith("tower_prefill."))
+        for at in range(0, count, chunk):
+            rows = min(chunk, count - at)
+            lines.append(f"PREFILL {name} start={at} rows={rows} worst_cos={cosine} max_abs={error}")
+    return "\n".join(lines) + "\nRESULT drama3 check PASS:\n"
+
+
+class PrefillTests(unittest.TestCase):
+    def test_chunk_boundaries_do_not_change_coverage(self):
+        for chunk in (2, 64, 128):
+            self.assertTrue(compare(receipt(1), receipt(chunk))["pass"])
+
+    def test_better_reference_error_passes(self):
+        self.assertTrue(compare(receipt(1), receipt(128, 1.0, 0.0))["pass"])
+
+    def test_either_error_regression_fails(self):
+        self.assertFalse(compare(receipt(1), receipt(128, 0.99))["pass"])
+        self.assertFalse(compare(receipt(1), receipt(128, error=2.0))["pass"])
+
+    def test_missing_or_misaligned_rows_fail(self):
+        for text in ("", receipt(128).replace("start=128", "start=127"),
+                     receipt(128).replace("rows=1 ", "rows=2 ")):
+            with self.assertRaises(ValueError):
+                collect(text)
+
+    def test_nonfinite_and_failed_reference_checks_fail(self):
+        for text in (receipt(128, float("nan")), receipt(128, error=float("inf")),
+                     receipt(128).replace("check PASS", "check FAIL")):
+            with self.assertRaises(ValueError):
+                collect(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
